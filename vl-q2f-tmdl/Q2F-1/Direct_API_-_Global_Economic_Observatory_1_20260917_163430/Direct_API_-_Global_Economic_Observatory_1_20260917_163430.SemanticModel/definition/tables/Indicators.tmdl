table Indicators
    lineageTag: af0891d5-0531-4905-b901-f07fbd6102c3
    annotation PBI_ResultType = Table
    column IndicatorCode
        sourceColumn: IndicatorCode
        dataType: string
        lineageTag: 5385a61b-53a6-401b-a4af-c05cd42e3b98
        summarizeBy: none
        annotation SummarizationSetBy = Automatic

