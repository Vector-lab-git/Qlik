	column Parameter
		isNameInferred
		sourceColumn: [Parameter]

	column Value
		isNameInferred
		sourceColumn: [Value]

	partition Parameters = calculated
		mode: import
		source =
				DATATABLE (
				    "Parameter", STRING, "Value", STRING,
				    {
				        { "ErrorMode", "1" },
				        { "StripComments", "1" },
				        { "OpenUrlTimeout", "86400" },
				        { "ScriptError", "1" },
				        { "ScriptErrorCount", "0" },
				        { "ScriptErrorList", "1" },
				        { "ThousandSep", "," },
				        { "DecimalSep", "." },
				        { "MoneyThousandSep", "," },
				        { "MoneyDecimalSep", "." },
				        { "MoneyFormat", "$ ###0.00;-$ ###0.00" },
				        { "TimeFormat", "h:mm:ss TT" },
				        { "DateFormat", "M/D/YYYY" },
				        { "TimestampFormat", "M/D/YYYY h:mm:ss[.fff] TT" },
				        { "FirstWeekDay", "6" },
				        { "BrokenWeeks", "1" },
				        { "ReferenceDay", "0" },
				        { "FirstMonthOfYear", "1" },
				        { "CollationLocale", "en-US" },
				        { "CreateSearchIndexOnReload", "1" },
				        { "MonthNames", "Jan;Feb;Mar;Apr;May;Jun;Jul;Aug;Sep;Oct;Nov;Dec" },
				        { "LongMonthNames", "January;February;March;April;May;June;July;August;September;October;November;December" },
				        { "DayNames", "Mon;Tue;Wed;Thu;Fri;Sat;Sun" },
				        { "LongDayNames", "Monday;Tuesday;Wednesday;Thursday;Friday;Saturday;Sunday" },
				        { "NumericalAbbreviation", "3:k;6:M;9:B;12:T;15:P;18:E" },
				        { "i", "10" },
				        { "vCode", "BX.KLT.DINV.CD.WD" },
				        { "vMinYear", "1990" },
				        { "vMaxYear", "2024" },
				        { "vLoadTime", "31 Aug 2026 03:07 AM" },
				        { "vColorPrimary", "#1F4E79" },
				        { "vColorAccent", "#2E9E5B" },
				        { "vColorWarning", "#E8A33D" },
				        { "vColorBad", "#D64550" },
				        { "vColorNeutral", "#8C99A6" },
				        { "vBase", "CountryType={'Country'}" },
				        { "vGDP", "Sum({<$(vBase), IndicatorCode={'NY.GDP.MKTP.CD'}>} IndicatorValue)" },
				        { "vGDPGrowth", "Avg({<$(vBase), IndicatorCode={'NY.GDP.MKTP.KD.ZG'}>} IndicatorValue)" },
				        { "vPopulation", "Sum({<$(vBase), IndicatorCode={'SP.POP.TOTL'}>} IndicatorValue)" },
				        { "vGDPPerCapita", "$(vGDP) / $(vPopulation)" },
				        { "vInflation", "Avg({<$(vBase), IndicatorCode={'FP.CPI.TOTL.ZG'}>} IndicatorValue)" },
				        { "vUnemployment", "Avg({<$(vBase), IndicatorCode={'SL.UEM.TOTL.ZS'}>} IndicatorValue)" },
				        { "vLifeExpectancy", "Avg({<$(vBase), IndicatorCode={'SP.DYN.LE00.IN'}>} IndicatorValue)" },
				        { "vExports", "Sum({<$(vBase), IndicatorCode={'NE.EXP.GNFS.CD'}>} IndicatorValue)" },
				        { "vImports", "Sum({<$(vBase), IndicatorCode={'NE.IMP.GNFS.CD'}>} IndicatorValue)" },
				        { "vTradeBalance", "$(vExports) - $(vImports)" },
				        { "vFDI", "Sum({<$(vBase), IndicatorCode={'BX.KLT.DINV.CD.WD'}>} IndicatorValue)" },
				        { "vInflationWeighted", "Sum(Aggr(Avg({<$(vBase), IndicatorCode={'FP.CPI.TOTL.ZG'}>} IndicatorValue) * $(vGDP), Country, Year)) / Sum(Aggr($(vGDP), Country, Year))" },
				        { "vGDPLY", "Sum({<$(vBase), IndicatorCode={'NY.GDP.MKTP.CD'}, Year={""$(=Max(Year)-1)""}>} IndicatorValue)" },
				        { "vGDPYoY", "($(vGDP) - $(vGDPLY)) / $(vGDPLY)" },
				        { "vGDPLatest", "Sum({<$(vBase), IndicatorCode={'NY.GDP.MKTP.CD'}, IsLatestYear={1}>} IndicatorValue)" },
				        { "vGDP10YrAgo", "Sum({<$(vBase), IndicatorCode={'NY.GDP.MKTP.CD'}, Year={""$(=Max(Year)-10)""}>} IndicatorValue)" },
				        { "vGDPCAGR10", "Pow($(vGDPLatest) / $(vGDP10YrAgo), 1/10) - 1" },
				        { "vIndicatorFor", "Sum({<$(vBase), IndicatorCode={'$1'}>} IndicatorValue)" },
				        { "vGDPForRegion", "Sum({<$(vBase), IndicatorCode={'NY.GDP.MKTP.CD'}, Region={'$1'}>} IndicatorValue)" },
				        { "vTopNEconomies", "Sum({<$(vBase), IndicatorCode={'NY.GDP.MKTP.CD'}, Country={""=Rank(Sum(IndicatorValue))<=$1""}>} IndicatorValue)" },
				        { "vGrowthScenarioPct", "0" },
				        { "vInflationScenarioPct", "0" },
				        { "vProjectionYears", "5" },
				        { "vTargetGrowthPct", "3" },
				        { "vSelectedIndicator", "NY.GDP.MKTP.CD" },
				        { "vDynamicMeasure", "Sum({<$(vBase), IndicatorCode={'$(vSelectedIndicator)'}>} IndicatorValue)" }
				    }
				)

	annotation PBI_Id = 14f38e30-4d50-45de-a2d7-4b2264dec5e3

