table Fact
	lineageTag: 8c366a5e-adce-4296-9a77-cc6ada132887

	measure 'Avg Annual GDP' = DIVIDE([vGDP], DISTINCTCOUNT('Years'[Year]), BLANK())
		lineageTag: 35620e47-8260-4766-bb6e-36146300dc19

	measure GDP = SUM('Fact'[IndicatorValue])
		lineageTag: 924fe09e-674e-4c69-b420-18ecfdb5eab5

	measure 'GDP (US$)' = VAR _MaxYear = MAX('Fact'[Year]) RETURN CALCULATE(SUM('Fact'[IndicatorValue]), 'Fact'[IndicatorCode] = "NY.GDP.MKTP.CD", 'Fact'[Year] = _MaxYear)
		lineageTag: 8933e12b-876a-485a-9275-2f21b3b8fe85

	measure 'GDP Last Year' = VAR _LastYear = MAX('Years'[Year]) - 1 RETURN CALCULATE(SUM('Fact'[GDPGrowthValue]), 'Fact'[Year] = _LastYear)
		lineageTag: 4b4472d0-4146-4a3b-b20a-b86c0f60a2e2

	measure 'World GDP Share %' = DIVIDE([vGDP], CALCULATE(SUM('Fact'[IndicatorValue]), ALLSELECTED(), 'Fact'[IndicatorCode] = "NY.GDP.MKTP.CD"), BLANK())
		formatString: 0.0%
		lineageTag: 7d0980ee-23da-4c4a-ac7f-fa65b8a6a3b7

	measure 'Exports (Latest Year)' = VAR _LatestYear = CALCULATE(MAX('Fact'[Year]), ALL('Fact')) RETURN CALCULATE(SUM('Fact'[IndicatorValue]), 'Fact'[Year] = _LatestYear, 'Fact'[IndicatorCode] = "NE.EXP.GNFS.CD")
		lineageTag: 582991fe-bced-48ec-9b2e-8d53b4c04e60

	measure 'Top 10 Share of World GDP' = DIVIDE([vTopNEconomies_10], CALCULATE(SUM('Fact'[IndicatorValue]), 'Fact'[IndicatorCode] = "NY.GDP.MKTP.CD"), BLANK())
		lineageTag: 70a3e16a-6faf-436e-9e2d-3329220119d2

	measure 'Avg Annual GDP — 5yr Moving Avg' = VAR _CurrentYear = MAX('Fact'[Year]) VAR _YearWindow = FILTER('Years', 'Years'[Year] <= _CurrentYear && 'Years'[Year] > _CurrentYear - 5) VAR _GDPAvg = AVERAGEX(_YearWindow, CALCULATE([vGDP], 'Fact'[Year] = 'Years'[Year])) RETURN _GDPAvg
		lineageTag: 4b87a790-0f43-40d9-88b7-52f92b7b4466

	measure 'Imports (Latest Year)' = CALCULATE(SUM('Fact'[IndicatorValue]), FILTER('Fact', 'Fact'[Year] = MAX('Fact'[Year])), 'Fact'[IndicatorCode] = "NE.IMP.GNFS.CD")
		lineageTag: e4215572-0f8f-4ee1-843b-57a64ad4e103

	measure 'GDP (Latest Year)' = CALCULATE(SUM('Fact'[IndicatorValue]), FILTER('Fact', 'Fact'[Year] = MAX('Fact'[Year])), 'Fact'[IndicatorCode] = "NY.GDP.MKTP.CD")
		lineageTag: d2467e34-d0a6-482b-bb47-e40ddf2dddf2

	measure 'Life Expectancy' = [vLifeExpectancy]
		lineageTag: 542025e7-8066-41c4-9314-f723b5226083

	measure 'GDP Rank' = VAR _CountrySet = ALLSELECTED('Countries'[Country]) VAR _RankTable = ADDCOLUMNS(_CountrySet, "_SumValue", CALCULATE(SUM('Fact'[IndicatorValue]), 'Fact'[IndicatorCode] = "NY.GDP.MKTP.CD")) RETURN IF(ISINSCOPE('Countries'[Country]) || HASONEVALUE('Countries'[Country]), RANKX(_CountrySet, CALCULATE(SUM('Fact'[IndicatorValue]), 'Fact'[IndicatorCode] = "NY.GDP.MKTP.CD"), , DESC, Dense), BLANK())
		lineageTag: 3c85cefa-7c97-408c-b967-d3d3eb62f452

	measure 'GDP CAGR 10yr' = VAR _FirstYear = MIN('Fact'[Year]) VAR _LastYear = MAX('Fact'[Year]) VAR _FirstGDP = CALCULATE(MIN('Fact'[GDPGrowthValue]), 'Fact'[Year] = _FirstYear) VAR _LastGDP = CALCULATE(MAX('Fact'[GDPGrowthValue]), 'Fact'[Year] = _LastYear) VAR _Periods = _LastYear - _FirstYear RETURN IF(_FirstGDP > 0 && _LastGDP > 0 && _Periods > 0, POWER(_LastGDP / _FirstGDP, 1 / _Periods) - 1, BLANK())
		lineageTag: 2a0009b2-11d6-4d30-bcbd-c821ece24678

	measure 'GDP per Capita' = DIVIDE(SUM('Fact'[IndicatorValue]), COUNTROWS('Countries'), BLANK())
		lineageTag: ff2ecc36-938f-4d86-8deb-394d961f032e

	measure 'Population (Latest Year)' = CALCULATE(SUM('Fact'[IndicatorValue]), 'Fact'[Year] = CALCULATE(MAX('Fact'[Year]), ALL('Fact')), 'Fact'[IndicatorCode] = "SP.POP.TOTL")
		lineageTag: a6e07c06-3699-4add-804a-245989f7ff85

	measure 'GDP Growth % (Latest Year)' = VAR _LatestYear = MAX('Fact'[Year]) RETURN DIVIDE(CALCULATE(AVERAGE('Fact'[IndicatorValue]), 'Fact'[IndicatorCode] = "NY.GDP.MKTP.KD.ZG", 'Fact'[Year] = _LatestYear), 100, BLANK())
		formatString: 0.0%
		lineageTag: 286a852c-a3f9-45a3-8369-05f72ec5efab

	measure 'GDP YoY %' = VAR _CurrentYear = MAX('Fact'[Year]) VAR _CurrentGDP = CALCULATE(SUM('Fact'[GDPGrowthValue]), 'Fact'[Year] = _CurrentYear) VAR _PriorGDP = CALCULATE(SUM('Fact'[GDPGrowthValue]), 'Fact'[Year] = _CurrentYear - 1) RETURN DIVIDE(_CurrentGDP - _PriorGDP, _PriorGDP, BLANK())
		formatString: 0.0%
		lineageTag: b7e6fbf2-392b-492f-a5ff-5bff410dc64b

	measure 'Rolling 5-Year Avg Growth' = AVERAGE('Fact'[GDPGrowthValue]) / 100
		lineageTag: 729fd2e1-70cb-4ec8-ae4e-e5d8deead27f

	measure Sum(IndicatorValue) = SUM('Fact'[IndicatorValue])
		lineageTag: 7bde61c0-13c9-47f6-93a9-acd8819ff190

	column CountryISO3
		dataType: string
		lineageTag: 2edcfc51-0d7a-4e37-8e83-d38e3c70abdd
		summarizeBy: none
		sourceColumn: CountryISO3

		annotation SummarizationSetBy = Automatic

