	column %RegionYearKey
		dataType: string
		lineageTag: cefe2fb7-43fe-4dd3-90c8-24f66da58e2a
		summarizeBy: none
		sourceColumn: '%RegionYearKey'

		annotation SummarizationSetBy = Automatic

	partition Fact = m
		mode: import
		source =
				let
				                // 1. Get the list of indicator codes at runtime from the Indicators query
				    IndicatorCodes = List.Distinct(Table.Column(AllIndicators, "IndicatorCode")),
				                // 2. Define the base URL and query parameters
				    BaseUrl = "https://api.worldbank.org",
				                RelPathBase = "v2/country/all/indicator/",
				                QueryParams = [
				                    format = "json",
				                    per_page = "20000",
				                    date = "1990:2024"
				                ],
				                // 3. Helper to fetch and parse a single indicator's data (with pagination)
				    FetchIndicator = (IndicatorCode as text) as table =>
				                    let
				                        // Helper to fetch a single page
				    GetPage = (PageNum as number) as list =>
				                            let
				                                Response = Web.Contents(
				                                    BaseUrl,
				                                    [
				                                        RelativePath = RelPathBase & IndicatorCode,
				                                        Query = Record.Combine({QueryParams, [page = Number.ToText(PageNum)]})
				                                    ]
				                                ),
				                                Json = Json.Document(Response),
				                                Meta = if List.Count(Json) > 0 then Json{0} else [],
				                                Data = if List.Count(Json) > 1 then (try Json{1} otherwise {}) else {}
				                            in
				                                Data,
				                        // Fetch page 1 to get total pages
				    FirstResponse = Web.Contents(
				                            BaseUrl,
				                            [
				                                RelativePath = RelPathBase & IndicatorCode,
				                                Query = QueryParams
				                            ]
				                        ),
				                        FirstJson = Json.Document(FirstResponse),
				                        FirstMeta = if List.Count(FirstJson) > 0 then FirstJson{0} else [],
				                        TotalPages = try Number.From(FirstMeta[pages]) otherwise 1,
				                        // Fetch all pages and combine
				    AllData = (try List.Combine(List.Transform({1..TotalPages}, each GetPage(_))) otherwise Table.Combine(List.Transform({1..TotalPages}, each GetPage(_)))),
				                        // Convert to table
				    DataTable = (if Value.Is(AllData, type table) then AllData else Table.FromRecords(AllData)),
				                        // Filter out rows with null __FK_root or value_u1 or empty countryiso3code
				    Filtered = Table.SelectRows(DataTable, each Record.HasFields(_, "value") and _[value] <> null and Record.HasFields(_, "countryiso3code") and Text.Length(Text.Trim(_[countryiso3code])) > 0),
				                        // Expand indicator and country nested records
				    ExpandIndicator = (try Table.ExpandRecordColumn(Filtered, "indicator", {"id", "value"}, {"IndicatorId", "IndicatorName"}) otherwise Table.AddColumn(Table.AddColumn(Filtered, "IndicatorId", each null), "IndicatorName", each null)),
				                        ExpandCountry = (try Table.ExpandRecordColumn(ExpandIndicator, "country", {"id", "value"}, {"CountryId", "CountryName"}) otherwise Table.AddColumn(Table.AddColumn(ExpandIndicator, "CountryId", each null), "CountryName", each null)),
				                        // Add derived columns
				    AddYear = Table.AddColumn(Table.RemoveColumns(ExpandCountry, {"Year"}, MissingField.Ignore), "Year", each try 2024 otherwise null, Int64.Type),
				                        AddIndicatorCode = Table.AddColumn(Table.RemoveColumns(AddYear, {"IndicatorCode"}, MissingField.Ignore), "IndicatorCode", each IndicatorCode, type text),
				                        AddIndicatorValue = Table.AddColumn(Table.RemoveColumns(AddIndicatorCode, {"IndicatorValue"}, MissingField.Ignore), "IndicatorValue", each try Number.From([value]) otherwise null, type number),
				                        AddGDPGrowthValue = Table.AddColumn(Table.RemoveColumns(AddIndicatorValue, {"GDPGrowthValue"}, MissingField.Ignore), "GDPGrowthValue", each if IndicatorCode = "NY.GDP.MKTP.KD.ZG" then try Number.From([value]) otherwise null else null, type number),
				                        // MapCountryRegion is not available in Power Query; set as "Unclassified"
				    AddRegion = Table.AddColumn(Table.RemoveColumns(AddGDPGrowthValue, {"Region"}, MissingField.Ignore), "Region", each "Unclassified", type text),
				                        AddRegionYearKey = Table.AddColumn(Table.RemoveColumns(AddRegion, {"%RegionYearKey"}, MissingField.Ignore), "%RegionYearKey", each Text.Combine({[Region], "|", Text.From([Year], "en-US")}), type text),
				                        // Rename columns to match schema
				    Renamed = Table.RenameColumns(AddRegionYearKey, {{"countryiso3code", "CountryISO3"}})
				                    in
				                        Renamed,
				                // 4. Fetch and combine all indicators
				    AllIndicators = Table.Combine(List.Transform(IndicatorCodes, each FetchIndicator(_))),
				                // 5. Select and type columns
				    Final = Table.TransformColumnTypes(List.Accumulate({"CountryISO3", "Year", "IndicatorCode", "IndicatorValue", "GDPGrowthValue", "%RegionYearKey"}, Table.SelectColumns(AllIndicators, {"CountryISO3", "Year", "IndicatorCode", "IndicatorValue", "GDPGrowthValue", "%RegionYearKey"}, MissingField.Ignore), (state, col) => if Table.HasColumns(state, col) then state else Table.AddColumn(state, col, each null)), {
				                        {"CountryISO3", type text},
				                        {"Year", Int64.Type},
				                        {"IndicatorCode", type text},
				                        {"IndicatorValue", type number},
				                        {"GDPGrowthValue", type number},
				                        {"%RegionYearKey", type text}
				                    })
				            in
				                Final

	annotation PBI_ResultType = Table

