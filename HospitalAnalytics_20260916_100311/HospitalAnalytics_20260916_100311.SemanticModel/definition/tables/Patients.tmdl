table Patients
	lineageTag: 816eb687-62e8-4673-8337-43f7a7e3f2fd

	measure 'Total Patients' = DISTINCTCOUNT('Patients'[PatientId])
		lineageTag: 5de388f4-8a88-48e5-8c9c-3f1a689fab5c

	measure 'Encounters per Patient' = DIVIDE(DISTINCTCOUNT('Encounters'[Id]), DISTINCTCOUNT('Patients'[PatientId]), BLANK())
		lineageTag: 4e33eac6-ae7b-4870-afe6-a2350a8ad5f1

	measure 'Average Patient Age' = AVERAGEX(FILTER('Patients', NOT(ISBLANK('Patients'[BIRTHDATE]))), (TODAY() - 'Patients'[BIRTHDATE]) / 365.25)
		lineageTag: 0d2bf559-40ca-4ef5-9015-83d96899d06a

