				                #"Renamed Columns" = Table.RenameColumns(Navigation, {{"Id", "PatientId"}, {"BIRTHDATE", "BIRTHDATE"}, {"DEATHDATE", "DEATHDATE"}, {"PREFIX", "PREFIX"}, {"FIRST", "FIRST"}, {"LAST", "LAST"}, {"SUFFIX", "SUFFIX"}, {"MAIDEN", "MAIDEN"}, {"MARITAL", "MARITAL"}, {"RACE", "RACE"}, {"ETHNICITY", "ETHNICITY"}, {"GENDER", "GENDER"}, {"BIRTHPLACE", "BIRTHPLACE"}, {"ADDRESS", "ADDRESS"}, {"CITY", "CITY"}, {"STATE", "STATE"}, {"COUNTY", "COUNTY"}, {"ZIP", "ZIP"}, {"LAT", "LAT"}, {"LON", "LON"}}, MissingField.Ignore),
				                #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns", {{"PatientId", type text}, {"BIRTHDATE", type date}, {"DEATHDATE", type text}, {"PREFIX", type text}, {"FIRST", type text}, {"LAST", type text}, {"SUFFIX", type text}, {"MAIDEN", type text}, {"MARITAL", type text}, {"RACE", type text}, {"ETHNICITY", type text}, {"GENDER", type text}, {"BIRTHPLACE", type text}, {"ADDRESS", type text}, {"CITY", type text}, {"STATE", type text}, {"COUNTY", type text}, {"ZIP", type text}, {"LAT", type number}, {"LON", type number}}),
				                #"Added PatientStatus" = Table.AddColumn(#"Changed Type", "PatientStatus", each if [DEATHDATE] = null or Text.Length(Text.Trim([DEATHDATE])) = 0 then "Alive" else "Deceased", type text),
				                #"Added PatientAge" = Table.AddColumn(#"Added PatientStatus", "PatientAge", each Number.RoundDown((Date.From(DateTime.LocalNow()) - [BIRTHDATE]) / 365.25), type number),
				                #"Added AgeGroup" = Table.AddColumn(#"Added PatientAge", "AgeGroup", each let age = Number.RoundDown((Date.From(DateTime.LocalNow()) - [BIRTHDATE]) / 365.25) in if age < 18 then "0-17" else if age < 35 then "18-34" else if age < 50 then "35-49" else if age < 65 then "50-64" else "65+", type text)
				            in
				                #"Added AgeGroup"

