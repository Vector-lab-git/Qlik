table Encounters
	lineageTag: fc6998c8-03f3-426e-85ad-266cdc1a5edc

	measure 'YoY Claim Cost Growth' = VAR _CurrentYear = MAX('Encounters'[Encounter Year]) VAR _CurrentCost = CALCULATE(SUM('Encounters'[TOTAL_CLAIM_COST]), 'Encounters'[Encounter Year] = _CurrentYear) VAR _PriorCost = CALCULATE(SUM('Encounters'[TOTAL_CLAIM_COST]), 'Encounters'[Encounter Year] = _CurrentYear - 1) RETURN DIVIDE(_CurrentCost - _PriorCost, _PriorCost, BLANK())
		lineageTag: f410790d-200d-4113-8d73-e8c995645cd9

	measure 'Total Claim Cost' = SUM('Encounters'[TOTAL_CLAIM_COST])
		lineageTag: 520cce09-1eef-4f0c-90f5-ab5d4487efba

	measure 'Total Base Encounter Cost' = SUM('Encounters'[BASE_ENCOUNTER_COST])
		lineageTag: 2eb2ccb3-2667-4629-8028-4c3e95245602

	measure 'Total Encounters' = DISTINCTCOUNT('Encounters'[Id])
		lineageTag: cf08becb-85d2-4d04-aca0-db6345284cf8

	measure 'Average Encounter Cost' = AVERAGE('Encounters'[TOTAL_CLAIM_COST])
		lineageTag: 27d7ec36-06a4-47cc-b38c-4b9ba29a25a8

	measure 'Total Payer Coverage' = SUM('Encounters'[PAYER_COVERAGE])
		lineageTag: a290a745-357c-40fd-a19b-00f33ac5afd5

	measure 'Avg Encounter Duration' = AVERAGEX(FILTER('Encounters', NOT(ISBLANK('Encounters'[START])) && NOT(ISBLANK('Encounters'[STOP]))), DATEDIFF('Encounters'[START], 'Encounters'[STOP], DAY))
		lineageTag: 0f42388b-88d3-4c7f-a7d4-839b85287024

	measure 'Coverage %' = DIVIDE(SUM('Encounters'[PAYER_COVERAGE]), SUM('Encounters'[TOTAL_CLAIM_COST]), BLANK())
		formatString: 0.0%
		lineageTag: b2eb20ff-ec2c-48b1-bff4-9a5dbbcafaca

	measure 'Cost Contribution %' = DIVIDE(SUM('Encounters'[TOTAL_CLAIM_COST]), CALCULATE(SUM('Encounters'[TOTAL_CLAIM_COST]), ALLSELECTED()), BLANK())
		formatString: 0.0%
		lineageTag: 8176fe09-c3d1-4335-bcee-69b5a1575d49

	measure 'Median Encounter Cost' = MEDIAN('Encounters'[TOTAL_CLAIM_COST])
		lineageTag: 33a0d70e-bd29-4b0a-b8eb-9b22c35754a6

	measure 'Patient Out-of-Pocket Cost' = ROUND(DIVIDE(SUM('Encounters'[TOTAL_CLAIM_COST]) - SUM('Encounters'[PAYER_COVERAGE]), 1000000, BLANK()), 1)
		formatString: \$#,##0.0\M
		lineageTag: a9ee9e8a-61a5-460e-afb4-50b85915144d

	measure 'High-Cost Encounters' = CALCULATE(DISTINCTCOUNT('Encounters'[Id]), FILTER('Encounters', 'Encounters'[TOTAL_CLAIM_COST] >=[vHighCostThreshold]))
		lineageTag: d3d01ede-b82e-4ef9-92c1-e32cd6f44b06

