				                #"Added ClaimCostBand" = Table.AddColumn(#"Added CoverageRate", "ClaimCostBand", each if [TOTAL_CLAIM_COST] < 500 then "Low" else if [TOTAL_CLAIM_COST] < 2000 then "Medium" else if [TOTAL_CLAIM_COST] < 10000 then "High" else "Very High", type text),
