				                #"Added EncounterDate" = Table.AddColumn(#"Changed Type", "EncounterDate", each Date.From([START]), type date),
				                #"Added EncounterYear" = Table.AddColumn(#"Added EncounterDate", "EncounterYear", each Date.Year([START]), type number),
