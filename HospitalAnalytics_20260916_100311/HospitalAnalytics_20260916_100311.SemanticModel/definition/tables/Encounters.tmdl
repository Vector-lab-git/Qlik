				                #"Added EncounterQuarter" = Table.AddColumn(#"Added EncounterYearMonth", "EncounterQuarter", each Date.ToText([START], "Q\Q yyyy"), type text),
				                #"Added EncounterWeek" = Table.AddColumn(#"Added EncounterQuarter", "EncounterWeek", each Date.WeekOfYear([START]), type number),
