table COURSES
	lineageTag: 3c274269-0b25-41aa-bd49-d9baa1ab8e54

	measure 'Total Departments' = DISTINCTCOUNT('COURSES'[DEPARTMENT])
		lineageTag: b76b012a-c9de-4bc1-8c1a-599220072074

	measure 'Average Course Credits' = AVERAGE('COURSES'[CREDITS])
		lineageTag: a4584bc6-5225-4337-a911-9467586e807c

	measure 'Total Courses' = DISTINCTCOUNT('COURSES'[COURSE_ID])
		lineageTag: 7e923c16-d2d6-4ead-ad02-73c30c4c8c49

	measure 'Average Assignment Credits' = AVERAGE('COURSES'[CREDITS])
		lineageTag: 946bb120-a9d8-41f0-a89f-e52f1b959f52

	measure 'Max Credits' = MAX('COURSES'[CREDITS])
		lineageTag: 5720971b-8d8f-476e-82a6-f7cb5f75dd90

	column COURSE_ID
