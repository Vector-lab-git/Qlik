		annotation SummarizationSetBy = Automatic

	column 'Course Category' = SWITCH(TRUE(), 'COURSES'[CREDITS] = 2, "Basic Course", TRUE(), "Other Course")
		dataType: string
		lineageTag: 3528066d-0128-46b6-9955-a09e1411fb68
		summarizeBy: none

