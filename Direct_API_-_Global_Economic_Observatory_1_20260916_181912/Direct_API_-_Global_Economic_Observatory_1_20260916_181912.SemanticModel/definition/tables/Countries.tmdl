	column %REGION_ACCESS
		dataType: string
		lineageTag: c3c52e80-704c-4358-a4a7-741fe1c3977c
		summarizeBy: none
		sourceColumn: %REGION_ACCESS

		annotation SummarizationSetBy = Automatic

	partition Countries = m
		mode: import
		source =
				let
				                // Base URL and endpoint for World Bank Countries API
				    BaseUrl = "https://api.worldbank.org",
				                RelPath = "v2/country",
				                QueryParams = [format = "json", per_page = "1000"],
				                // Helper to fetch a single page and return the JSON response
				    GetPage = (PageNumber as number) as list =>
				                    let
				                        Response = Web.Contents(
				                            BaseUrl,
				                            [
				                                RelativePath = RelPath,
				                                Query = Record.Combine({QueryParams, [page = Number.ToText(PageNumber)]})
				                            ]
				                        ),
				                        Json = Json.Document(Response),
				                        Data = if List.Count(Json) > 1 then (try Json{1} otherwise {}) else {}
				                    in
				                        Data,
				                // Fetch the first page to determine total number of pages
				    FirstPageResponse = Web.Contents(
				                    BaseUrl,
				                    [
				                        RelativePath = RelPath,
				                        Query = Record.Combine({QueryParams, [page = "1"]})
				                    ]
				                ),
				                FirstPageJson = Json.Document(FirstPageResponse),
				                Meta = if List.Count(FirstPageJson) > 0 then FirstPageJson{0} else [],
				                TotalPages = try Meta[pages] otherwise 1,
				                // Fetch all pages and combine
				    AllPages = (try List.Combine(List.Transform({1..TotalPages}, each GetPage(_))) otherwise Table.Combine(List.Transform({1..TotalPages}, each GetPage(_)))),
				                CountriesRaw = (if Value.Is(AllPages, type table) then AllPages else Table.FromRecords(AllPages)),
				                // Expand nested fields: region, adminregion, incomeLevel, lendingType
				    ExpandRegion = (try Table.ExpandRecordColumn(CountriesRaw, "region", {"value"}, {"Region"}) otherwise Table.AddColumn(Table.RemoveColumns(CountriesRaw, {"Region"}, MissingField.Ignore), "Region", each null)),
				                ExpandAdminRegion = (try Table.ExpandRecordColumn(ExpandRegion, "adminregion", {"value"}, {"AdminRegion"}) otherwise Table.AddColumn(Table.RemoveColumns(ExpandRegion, {"AdminRegion"}, MissingField.Ignore), "AdminRegion", each null)),
				                ExpandIncomeLevel = (try Table.ExpandRecordColumn(ExpandAdminRegion, "incomeLevel", {"value"}, {"IncomeGroup"}) otherwise Table.AddColumn(Table.RemoveColumns(ExpandAdminRegion, {"IncomeGroup"}, MissingField.Ignore), "IncomeGroup", each null)),
				                ExpandLendingType = (try Table.ExpandRecordColumn(ExpandIncomeLevel, "lendingType", {"value"}, {"LendingType"}) otherwise Table.AddColumn(Table.RemoveColumns(ExpandIncomeLevel, {"LendingType"}, MissingField.Ignore), "LendingType", each null)),
				                // Rename and select columns to match Qlik output
				    Renamed = Table.RenameColumns(ExpandLendingType, {{"id", "CountryISO3"}, {"iso2Code", "CountryISO2"}, {"name", "Country"}, {"capitalCity", "CapitalCity"}, {"longitude", "CountryLong"}, {"latitude", "CountryLat"}}),
				                // Add CountryType column: 'Aggregate' if Region is empty or 'Aggregates', else 'Country'
				    AddCountryType = Table.AddColumn(Table.RemoveColumns(Renamed, {"CountryType"}, MissingField.Ignore), "CountryType",
				                    each if Text.Length(Text.Trim([Region])) = 0 or [Region] = "Aggregates" then "Aggregate" else "Country"
				                ),
				                // Add CountryPoint column: POINT(long lat) if both are numbers
				    AddCountryPoint = Table.AddColumn(Table.RemoveColumns(AddCountryType, {"CountryPoint"}, MissingField.Ignore), "CountryPoint",
				                    each if Value.Is([CountryLat], type number) and Value.Is([CountryLong], type number)
				                        then "POINT(" & Number.ToText([CountryLong]) & " " & Number.ToText([CountryLat]) & ")"
				                        else null
				                ),
				                // Add %REGION_ACCESS column: upper-case Region
				    AddRegionAccess = Table.AddColumn(Table.RemoveColumns(AddCountryPoint, {"%REGION_ACCESS"}, MissingField.Ignore), "%REGION_ACCESS",
				                    each Text.Upper([Region])
				                ),
				                // Add IncomeRank column based on IncomeGroup and CountryType
				    AddIncomeRank = Table.AddColumn(Table.RemoveColumns(AddRegionAccess, {"IncomeRank"}, MissingField.Ignore), "IncomeRank",
				                    each if [CountryType] = "Aggregate" then "Aggregate"
				                        else if [IncomeGroup] = "High income" then "1. High"
				                        else if [IncomeGroup] = "Upper middle income" then "2. Upper Middle"
				                        else if [IncomeGroup] = "Lower middle income" then "3. Lower Middle"
				                        else if [IncomeGroup] = "Low income" then "4. Low"
				                        else "5. Unclassified"
				                ),
				                // Final column selection and typing
				    Final = Table.TransformColumnTypes(List.Accumulate({"CountryISO3", "CountryISO2", "Country", "CapitalCity", "CountryLong", "CountryLat", "Region", "IncomeGroup", "LendingType", "CountryType", "CountryPoint", "%REGION_ACCESS", "IncomeRank"}, Table.SelectColumns(AddIncomeRank, {"CountryISO3",
				                            "CountryISO2",
				                            "Country",
				                            "CapitalCity",
				                            "CountryLong",
				                            "CountryLat",
				                            "Region",
				                            "IncomeGroup",
				                            "LendingType",
				                            "CountryType",
				                            "CountryPoint",
				                            "%REGION_ACCESS",
				                            "IncomeRank"}, MissingField.Ignore), (state, col) => if Table.HasColumns(state, col) then state else Table.AddColumn(state, col, each null)), {
				                        {"CountryISO3", type text},
				                        {"CountryISO2", type text},
				                        {"Country", type text},
				                        {"CapitalCity", type text},
				                        {"CountryLong", type number},
				                        {"CountryLat", type number},
				                        {"Region", type text},
				                        {"IncomeGroup", type text},
				                        {"LendingType", type text},
				                        {"CountryType", type text},
				                        {"CountryPoint", type text},
				                        {"%REGION_ACCESS", type text},
				                        {"IncomeRank", type text}
				                    })
				            in
				                Final

	annotation PBI_ResultType = Table

