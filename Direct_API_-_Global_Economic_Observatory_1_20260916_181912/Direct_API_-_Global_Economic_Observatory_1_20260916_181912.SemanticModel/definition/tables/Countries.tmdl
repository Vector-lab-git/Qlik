	column 'Economy Size Band' = VAR gdp_value = VALUE(RELATED('Fact'[IndicatorValue])) VAR gdp_band = FLOOR(gdp_value / 1000000000, 500) RETURN COALESCE( FORMAT(gdp_band, "#") & " bn USD", BLANK() )
		dataType: string
