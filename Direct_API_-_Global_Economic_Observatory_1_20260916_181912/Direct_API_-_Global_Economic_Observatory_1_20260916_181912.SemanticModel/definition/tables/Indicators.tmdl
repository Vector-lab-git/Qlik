	column 'Top 10 Economies + Rest of World' = VAR Top10Countries = TOPN(10, FILTER(ALL('Fact'), 'Indicators'[IndicatorCode] = "NY.GDP.MKTP.CD"), RELATED('Fact'[IndicatorValue]), DESC) VAR IsTop10 = CONTAINS(Top10Countries, RELATED('Countries'[CountryISO3]), RELATED('Fact'[CountryISO3])) RETURN SWITCH( TRUE(), IsTop10, RELATED('Countries'[Country]), TRUE(), "Rest of World" )
		dataType: string
		lineageTag: 0c69a3f7-6785-4830-ac95-8f9d1248613f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Growth Classification' = VAR avg_gdp_growth = AVERAGEX( FILTER( FILTER( ALL('Fact'), 'Indicators'[IndicatorCode] = "NY.GDP.MKTP.KD.ZG" ), RELATED('Fact'[CountryISO3]) = EARLIER(RELATED('Fact'[CountryISO3])) ), RELATED('Fact'[IndicatorValue]) ) RETURN SWITCH( TRUE(), avg_gdp_growth >= 6, "1. High Growth (6%+)", avg_gdp_growth >= 3, "2. Solid Growth (3-6%)", avg_gdp_growth >= 0, "3. Slow Growth (0-3%)", "4. Contraction" )
		dataType: string
		lineageTag: 4283c963-213d-4db2-be7b-e009694936f1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Indicator Drill' = 'Indicators'[IndicatorGroup]
