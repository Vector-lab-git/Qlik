	partition DeliveryByTrip = m
		mode: import
		source =
				let
				                Source = DeliveryEvents,
				                #"Grouped by trip_id" = Table.Group(Source, {"trip_id"}, {{"DeliveryEvents", each List.Count(List.Distinct([event_id])), type number}, {"OnTimeEvents", each List.Sum(List.Transform([on_time_flag], (x) => if (x = 1 or x = true or x = "1") then 1 else 0)), type number}, {"LateEvents", each List.Sum(List.Transform([on_time_flag], (x) => if x = 0 then 1 else 0)), type number}, {"OnTimeRate", each if List.Count(List.Distinct([event_id])) > 0 then List.Sum(List.Transform([on_time_flag], (x) => if (x = 1 or x = true or x = "1") then 1 else 0)) / List.Count(List.Distinct([event_id])) else 0, type number}, {"TotalDetentionMinutes", each List.Sum([detention_minutes]), type number}, {"AvgDetentionMinutes", each List.Average([detention_minutes]), type number}}),
				                #"Added TruckNumber" = Table.AddColumn(#"Grouped by trip_id", "TruckNumber", each "Unknown", type text)
				            in
				                #"Added TruckNumber"

	annotation PBI_ResultType = Table

