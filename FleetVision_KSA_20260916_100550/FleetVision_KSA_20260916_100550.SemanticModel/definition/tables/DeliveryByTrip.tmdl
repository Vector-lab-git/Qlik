table DeliveryByTrip
	lineageTag: 8bc0f9cb-e7ec-406a-8665-5763fbe74717

	measure 'Maximum Trips by Truck' = MAXX(VALUES('Trucks'[truck_id]), CALCULATE(COUNT('DeliveryByTrip'[trip_id])))
		lineageTag: 26b0dac4-a3f2-4374-911e-4a2e82688888

	measure 'Revenue per Trip' = DIVIDE(SUM('Loads'[revenue]), COUNT('DeliveryByTrip'[trip_id]), BLANK())
		lineageTag: bbb0f8ab-9248-4e50-bf5f-3a8dc8a796a1

	measure 'Completed Trips' = CALCULATE(COUNT('DeliveryByTrip'[trip_id]), 'Trips'[trip_status] = "Completed", CROSSFILTER('DeliveryByTrip'[trip_id], 'Trips'[trip_id], Both))
		lineageTag: fb10d629-255b-4a1a-a89b-81ddf526c38e

	measure 'Total Trips' = COUNT('DeliveryByTrip'[trip_id])
		lineageTag: 018fe93d-b631-4aaa-af42-98e809e67005

	measure 'Fleet Operations' = MAXX(VALUES('Trucks'[truck_id]), CALCULATE(COUNT('DeliveryByTrip'[trip_id])))
		lineageTag: c5bb5b97-02e8-42e6-88c6-1a7ff1571f79

