model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["StudentData","SalesData"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode","WebModelingEdit"]

ref table StudentData
ref table SalesData
ref table 'Selected Metric'
ref table Parameters

ref cultureInfo en-US

