table Fact
	lineageTag: aded7630-d833-4dcb-99fb-3e90df172a4e

	measure 'Avg Annual GDP' = DIVIDE(SUM('Fact'[IndicatorValue]), DISTINCTCOUNT('Years'[Year]), BLANK())
		lineageTag: 11d28ce0-f9e3-427b-bc5b-dc560167768e

	measure GDP = SUM('Fact'[IndicatorValue])
		lineageTag: b1bbb7bf-751f-4570-93e8-784dd8d86bb8

	measure 'GDP per Capita' = DIVIDE(SUM('Fact'[IndicatorValue]), SUM('Fact'[CountryISO3]), BLANK())
		lineageTag: b2c3c3ac-9006-4b2c-b23c-21f9db40bed0

	measure 'Avg Annual GDP — 5yr Moving Avg' = VAR _CurrentYear = MAX('Fact'[Year]) VAR _YearWindow = FILTER('Years', 'Years'[Year] <= _CurrentYear && 'Years'[Year] > _CurrentYear - 5) VAR _GDPAvg = AVERAGEX(_YearWindow, CALCULATE([vGDP], 'Fact'[Year] = 'Years'[Year])) RETURN AVERAGE(_GDPAvg)
		lineageTag: 5dfb4db2-b424-4156-8212-2b943b16b2b6

	measure 'GDP Rank' = IF(ISINSCOPE('Countries'[Country]) || HASONEVALUE('Countries'[Country]), RANKX(ALLSELECTED('Countries'[Country]), CALCULATE(SUM('Fact'[IndicatorValue]), 'Fact'[IndicatorCode] = "NY.GDP.MKTP.CD"), , DESC, Dense), BLANK())
		lineageTag: 213978f6-d4e9-473f-a0e3-0f900764e49f

	measure 'Imports (Latest Year)' = VAR _LatestYear = CALCULATE(MAX('Fact'[Year]), ALLSELECTED()) RETURN CALCULATE(SUM('Fact'[IndicatorValue]), 'Fact'[Year] = _LatestYear, 'Fact'[IndicatorCode] = "NE.IMP.GNFS.CD")
		lineageTag: 9b476286-55e0-432e-bd2c-104323723aec

	measure 'GDP CAGR 10yr' = VAR _FirstYear = MIN('Fact'[Year]) VAR _LastYear = MAX('Fact'[Year]) VAR _FirstGDP = CALCULATE(MIN('Fact'[IndicatorValue]), 'Fact'[Year] = _FirstYear, 'Fact'[IndicatorCode] = "NY.GDP.MKTP.CD") VAR _LastGDP = CALCULATE(MAX('Fact'[IndicatorValue]), 'Fact'[Year] = _LastYear, 'Fact'[IndicatorCode] = "NY.GDP.MKTP.CD") VAR _Periods = _LastYear - _FirstYear RETURN IF(_Periods > 0 && NOT(ISBLANK(_FirstGDP)) && NOT(ISBLANK(_LastGDP)), (POWER(DIVIDE(_LastGDP, _FirstGDP, BLANK()), DIVIDE(1, _Periods, BLANK())) - 1), BLANK())
		lineageTag: cf7e8bc5-9d41-465e-be14-842ec08b067e

	measure 'GDP (US$)' = CALCULATE(SUM('Fact'[IndicatorValue]), 'Fact'[IndicatorCode] = "NY.GDP.MKTP.CD", FILTER('Fact', 'Fact'[Year] = MAX('Fact'[Year])))
		lineageTag: a5f8eb33-9093-48f7-92e3-6b8958c5074b

	measure 'Top 10 Share of World GDP' = DIVIDE([vTopNEconomies_10], CALCULATE(SUM('Fact'[IndicatorValue]), 'Fact'[IndicatorCode] = "NY.GDP.MKTP.CD"), BLANK())
		lineageTag: 7d0e58ca-ed9e-4ec4-9e03-292618501af4

	measure 'Life Expectancy' = AVERAGEX('Fact', 'Fact'[IndicatorValue])
		lineageTag: 1d2d28e1-eecb-45f8-9c65-bef71347e414

	measure 'Population (Latest Year)' = VAR _LatestYear = MAX('Fact'[Year]) RETURN CALCULATE(SUM('Fact'[IndicatorValue]), 'Fact'[Year] = _LatestYear, 'Fact'[IndicatorCode] = "SP.POP.TOTL")
		lineageTag: abaa6e08-cd08-453e-9e87-0d12b4fa243a

	measure 'Exports (Latest Year)' = VAR _LatestYear = CALCULATE(MAX('Fact'[Year]), ALL('Fact')) RETURN CALCULATE(SUM('Fact'[IndicatorValue]), 'Fact'[Year] = _LatestYear, 'Fact'[IndicatorCode] = "NE.EXP.GNFS.CD")
		lineageTag: c8346e31-c5a3-4b22-b24a-9a45466c53c0

	measure 'GDP (Latest Year)' = CALCULATE(SUM('Fact'[IndicatorValue]), 'Fact'[Year] = CALCULATE(MAX('Fact'[Year]), ALL('Fact')), 'Fact'[IndicatorCode] = "NY.GDP.MKTP.CD")
		lineageTag: add596d5-b447-4b9b-9ad3-ae50575519d3

	measure 'GDP Growth % (Latest Year)' = DIVIDE(CALCULATE(AVERAGEX('Fact', IFERROR(VALUE('Fact'[IndicatorValue]), BLANK())), 'Fact'[IndicatorCode] = "NY.GDP.MKTP.KD.ZG", 'Fact'[Year] = CALCULATE(MAX('Fact'[Year]), ALL('Fact'))), 100, BLANK())
		formatString: 0.0%
		lineageTag: a1d39e03-8f31-4ef6-9ca7-c183ad6b52df

	measure 'World GDP Share %' = DIVIDE([vGDP], CALCULATE(SUM('Fact'[IndicatorValue]), ALLSELECTED(), 'Fact'[IndicatorCode] = "NY.GDP.MKTP.CD"), BLANK())
		formatString: 0.0%
		lineageTag: 38ee3a63-7caa-426c-8a51-31961874ed30

	measure Sum(IndicatorValue) = SUM('Fact'[IndicatorValue])
		lineageTag: 5325b106-a0b6-477a-b0e6-f03c0567478c

