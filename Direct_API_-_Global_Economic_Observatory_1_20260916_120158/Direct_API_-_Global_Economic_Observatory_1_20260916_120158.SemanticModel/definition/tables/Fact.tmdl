	column %RegionYearKey
		dataType: string
		lineageTag: 0bd5ca58-a4f4-4afe-bc29-0735e23f9ea2
		summarizeBy: none
		sourceColumn: '%RegionYearKey'

		annotation SummarizationSetBy = Automatic

	partition Fact = m
		mode: import
		source =
				let
				                // 1. Get the list of indicator codes at runtime from the Indicators query
				    IndicatorCodes = List.Distinct(Table.Column(AllIndicators, "IndicatorCode")),
				                // 2. Define the base URL and query parameters
				    BaseUrl = "https://api.worldbank.org",
				                RelPathTemplate = "v2/country/all/indicator/",
				                QueryParams = [
				                    format = "json",
				                    per_page = "20000",
				                    date = "1990:2024"
				                ],
				                // 3. Helper to fetch and parse a single indicator's data (with pagination)
				    FetchIndicator = (IndicatorCode as text) as table =>
				                    let
				                        // Helper to fetch a single page
				    GetPage = (PageNum as number) as list =>
				                            let
				                                Response = Web.Contents(
				                                    BaseUrl,
				                                    [
				                                        RelativePath = RelPathTemplate & IndicatorCode,
				                                        Query = Record.Combine({QueryParams, [page = Number.ToText(PageNum)]})
				                                    ]
				                                ),
				                                Json = Json.Document(Response),
				                                Meta = if List.Count(Json) > 0 then Json{0} else [],
				                                Data = if List.Count(Json) > 1 then (try Json{1} otherwise {}) else {}
				                            in
				                                Data,
				                        // Fetch page 1 to get total pages
				    FirstResponse = Web.Contents(
				                            BaseUrl,
				                            [
				                                RelativePath = RelPathTemplate & IndicatorCode,
				                                Query = QueryParams
				                            ]
				                        ),
				                        FirstJson = Json.Document(FirstResponse),
				                        FirstMeta = if List.Count(FirstJson) > 0 then FirstJson{0} else [],
				                        TotalPages = try Number.From(FirstMeta[pages]) otherwise 1,
				                        // Fetch all pages and combine
				    AllData = (try List.Combine(List.Transform({1..TotalPages}, each GetPage(_))) otherwise Table.Combine(List.Transform({1..TotalPages}, each GetPage(_)))),
				                        // Convert to table
				    DataTable = (if Value.Is(AllData, type table) then AllData else Table.FromRecords(AllData)),
				                        // Remove rows with null __FK_root or value_u1 or empty countryiso3code
				    Filtered = Table.SelectRows(DataTable, each Record.HasFields(_, "value_u1") and _[value_u1] <> null and Record.HasFields(_, "countryiso3code") and Text.Length(Text.Trim(_[countryiso3code])) > 0),
				                        // Add IndicatorCode column
				    WithIndicator = Table.AddColumn(Table.RemoveColumns(Filtered, {"IndicatorCode"}, MissingField.Ignore), "IndicatorCode", each IndicatorCode, type text),
				                        // Add Year column (numeric from 2024)
				    WithYear = Table.AddColumn(Table.RemoveColumns(WithIndicator, {"Year"}, MissingField.Ignore), "Year", each try 2024 otherwise null, Int64.Type),
				                        // Add IndicatorValue column (numeric from [value_u1])
				    WithValue = Table.AddColumn(Table.RemoveColumns(WithYear, {"IndicatorValue"}, MissingField.Ignore), "IndicatorValue", each try Number.From([value_u1]) otherwise null, type number),
				                        // Add GDPGrowthValue column (only for NY.GDP.MKTP.KD.ZG)
				    WithGDPGrowth = Table.AddColumn(Table.RemoveColumns(WithValue, {"GDPGrowthValue"}, MissingField.Ignore), "GDPGrowthValue", each if IndicatorCode = "NY.GDP.MKTP.KD.ZG" then [IndicatorValue] else null, type number),
				                        // Add %RegionYearKey column (region mapping not available, so use countryiso3code|date)
				    WithRegionYearKey = Table.AddColumn(Table.RemoveColumns(WithGDPGrowth, {"%RegionYearKey"}, MissingField.Ignore), "%RegionYearKey", each [countryiso3code] & "|" & Text.From(2024), type text),
				                        // Rename columns to match model
				    Renamed = Table.RenameColumns(WithRegionYearKey, {{"countryiso3code", "CountryISO3"}})
				                    in
				                        Renamed,
				                // 4. Fetch and combine all indicators
				    AllIndicators = List.Transform(IndicatorCodes, each FetchIndicator(_)),
				                Combined = Table.Combine(AllIndicators),
				                // 5. Select and type columns
				    Final = Table.SelectColumns(Combined, {"CountryISO3", "Year", "IndicatorCode", "IndicatorValue", "GDPGrowthValue", "%RegionYearKey"}, MissingField.Ignore),
				                Typed = Table.TransformColumnTypes(List.Accumulate({"CountryISO3", "Year", "IndicatorCode", "IndicatorValue", "GDPGrowthValue", "%RegionYearKey"}, Final, (state, col) => if Table.HasColumns(state, col) then state else Table.AddColumn(state, col, each null)), {
				                    {"CountryISO3", type text},
				                    {"Year", Int64.Type},
				                    {"IndicatorCode", type text},
				                    {"IndicatorValue", type number},
				                    {"GDPGrowthValue", type number},
				                    {"%RegionYearKey", type text}
				                })
				            in
				                Typed

	annotation PBI_ResultType = Table

