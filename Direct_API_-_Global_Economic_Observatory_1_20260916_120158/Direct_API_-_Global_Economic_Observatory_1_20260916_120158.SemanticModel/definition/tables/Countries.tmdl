	column 'Trade Position' = VAR Exports = CALCULATE( SUM(RELATED('Fact'[IndicatorValue])), RELATED('Fact'[IndicatorCode]) = "EXPORTS" ) VAR Imports = CALCULATE( SUM(RELATED('Fact'[IndicatorValue])), RELATED('Fact'[IndicatorCode]) = "IMPORTS" ) RETURN SWITCH(TRUE(), Exports > Imports * 1.1, "Strong Surplus", Exports > Imports, "Surplus", Imports > Exports * 1.1, "Strong Deficit", "Deficit" )
		dataType: string
		lineageTag: da60a766-c284-4e09-a88b-31b9ae9917cc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Countries = m
		mode: import
		source =
				let
				                // Base URL and endpoint for World Bank Countries REST API
				    BaseUrl = "https://api.worldbank.org",
				                RelPath = "v2/country",
				                QueryParams = [format = "json", per_page = "1000"],
				                // Helper to fetch a single page and return the JSON list of country records
				    GetPage = (PageNumber as number) as list =>
				                    let
				                        Response = Web.Contents(BaseUrl, [
				                            RelativePath = RelPath,
				                            Query = Record.Combine({QueryParams, [page = Number.ToText(PageNumber)]})
				                        ]),
				                        Json = Json.Document(Response),
				                        Data = if List.Count(Json) > 1 then (try Json{1} otherwise {}) else {}
				                    in
				                        Data,
				                // Fetch first page to determine total number of pages
				    FirstPageResponse = Web.Contents(BaseUrl, [RelativePath = RelPath, Query = QueryParams]),
				                FirstPageJson = Json.Document(FirstPageResponse),
				                Meta = if List.Count(FirstPageJson) > 0 then FirstPageJson{0} else [],
				                TotalPages = try Meta[pages] otherwise 1,
				                Pages = {1..TotalPages},
				                // Fetch all pages and combine
				    AllData = (try List.Combine(List.Transform(Pages, each GetPage(_))) otherwise Table.Combine(List.Transform(Pages, each GetPage(_)))),
				                CountriesRaw = (if Value.Is(AllData, type table) then AllData else Table.FromRecords(AllData)),
				                // Expand nested fields and select/rename columns
				    Countries1 = (try Table.ExpandRecordColumn(CountriesRaw, "region", {"value"}, {"Region"}) otherwise Table.AddColumn(Table.RemoveColumns(CountriesRaw, {"Region"}, MissingField.Ignore), "Region", each null)),
				                Countries2 = (try Table.ExpandRecordColumn(Countries1, "adminregion", {"value"}, {"AdminRegion"}) otherwise Table.AddColumn(Table.RemoveColumns(Countries1, {"AdminRegion"}, MissingField.Ignore), "AdminRegion", each null)),
				                Countries3 = (try Table.ExpandRecordColumn(Countries2, "incomeLevel", {"value"}, {"IncomeGroup"}) otherwise Table.AddColumn(Table.RemoveColumns(Countries2, {"IncomeGroup"}, MissingField.Ignore), "IncomeGroup", each null)),
				                Countries4 = (try Table.ExpandRecordColumn(Countries3, "lendingType", {"value"}, {"LendingType"}) otherwise Table.AddColumn(Table.RemoveColumns(Countries3, {"LendingType"}, MissingField.Ignore), "LendingType", each null)),
				                Countries5 = Table.RenameColumns(Countries4, {{"id", "CountryISO3"}, {"iso2Code", "CountryISO2"}, {"name", "Country"}, {"capitalCity", "CapitalCity"}, {"longitude", "CountryLong"}, {"latitude", "CountryLat"}}),
				                // Add CountryType column
				    Countries6 = Table.AddColumn(Table.RemoveColumns(Countries5, {"CountryType"}, MissingField.Ignore), "CountryType", each if Text.Length(Text.Trim([Region])) = 0 or [Region] = "Aggregates" then "Aggregate" else "Country"),
				                // Add CountryPoint column (WKT POINT if both lat/long are numbers)
				    Countries7 = Table.AddColumn(Table.RemoveColumns(Countries6, {"CountryPoint"}, MissingField.Ignore), "CountryPoint", each if Value.Is([CountryLat], type number) and Value.Is([CountryLong], type number) then "POINT(" & Number.ToText([CountryLong]) & " " & Number.ToText([CountryLat]) & ")" else null),
				                // Add %REGION_ACCESS column (uppercase region)
				    Countries8 = Table.AddColumn(Table.RemoveColumns(Countries7, {"%REGION_ACCESS"}, MissingField.Ignore), "%REGION_ACCESS", each Text.Upper([Region])),
				                // Add IncomeRank column
				    Countries9 = Table.AddColumn(Table.RemoveColumns(Countries8, {"IncomeRank"}, MissingField.Ignore), "IncomeRank", each if [CountryType] = "Aggregate" then "Aggregate" else if [IncomeGroup] = "High income" then "1. High" else if [IncomeGroup] = "Upper middle income" then "2. Upper Middle" else if [IncomeGroup] = "Lower middle income" then "3. Lower Middle" else if [IncomeGroup] = "Low income" then "4. Low" else "5. Unclassified"),
				                // Final column selection and type enforcement
				    Countries = Table.TransformColumnTypes(List.Accumulate({"CountryISO3", "CountryISO2", "Country", "CapitalCity", "CountryLong", "CountryLat", "Region", "IncomeGroup", "LendingType", "CountryType", "CountryPoint", "%REGION_ACCESS", "IncomeRank"}, Table.SelectColumns(Countries9, {"CountryISO3", "CountryISO2", "Country", "CapitalCity", "CountryLong", "CountryLat", "Region", "IncomeGroup", "LendingType", "CountryType", "CountryPoint", "%REGION_ACCESS", "IncomeRank"}, MissingField.Ignore), (state, col) => if Table.HasColumns(state, col) then state else Table.AddColumn(state, col, each null)), {
				                        {"CountryISO3", type text},
				                        {"CountryISO2", type text},
				                        {"Country", type text},
				                        {"CapitalCity", type text},
				                        {"CountryLong", type number},
				                        {"CountryLat", type number},
				                        {"Region", type text},
				                        {"IncomeGroup", type text},
				                        {"LendingType", type text},
				                        {"CountryType", type text},
				                        {"CountryPoint", type text},
				                        {"%REGION_ACCESS", type text},
				                        {"IncomeRank", type text}
				                    })
				            in
				                Countries

	annotation PBI_ResultType = Table

