	column 'Economy Size Band' = VAR gdp_fact = CALCULATE( SUM(RELATED('Fact'[IndicatorValue])), RELATED('Fact'[IndicatorCode]) = "GDP", 'Countries'[CountryISO3] = 'Countries'[CountryISO3] ) VAR gdp_billion = DIVIDE(gdp_fact, 1000000000) VAR band_floor = FLOOR(gdp_billion, 500) VAR band_text = COALESCE(band_floor, 0) & " bn USD" RETURN band_text
		dataType: string
		lineageTag: 8f7f9e8c-7bd0-4f1d-8ae7-9dae4556882f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Income Group' = SWITCH(TRUE(), 'Countries'[CountryType] = "Country", 'Countries'[IncomeGroup], BLANK())
