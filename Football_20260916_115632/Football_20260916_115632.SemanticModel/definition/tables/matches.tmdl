	partition matches = m
		mode: import
		source =
				let
				                Source = PostgreSQL.Database("t2f-postgre-server.postgres.database.azure.com", "test"),
				                Result = Value.NativeQuery(Source, "SELECT ""match_id"", ""season"", ""match_week"", ""match_date"", ""home_team_id"", ""away_team_id"", ""home_score"", ""away_score"", ""stadium"", ""attendance"", ""referee"" FROM ""public"".""matches""", null, [EnableFolding=false]),
				                #"Renamed Columns" = Table.RenameColumns(Result, {{"stadium", "match_stadium"}}, MissingField.Ignore),
				                #"Added total_goals" = Table.AddColumn(#"Renamed Columns", "total_goals", each [home_score] + [away_score], type number),
				                #"Added match_goal_difference" = Table.AddColumn(#"Added total_goals", "match_goal_difference", each [home_score] - [away_score], type number),
				                #"Added match_result" = Table.AddColumn(#"Added match_goal_difference", "match_result", each if [home_score] > [away_score] then "Home Win" else if [home_score] < [away_score] then "Away Win" else "Draw", type text),
				                #"Added home_points" = Table.AddColumn(#"Added match_result", "home_points", each if [home_score] > [away_score] then 3 else if [home_score] = [away_score] then 1 else 0, type number),
				                #"Added away_points" = Table.AddColumn(#"Added home_points", "away_points", each if [away_score] > [home_score] then 3 else if [away_score] = [home_score] then 1 else 0, type number),
				                #"Added match_goal_band" = Table.AddColumn(#"Added away_points", "match_goal_band", each if [home_score] + [away_score] <= 1 then "Low Scoring" else if [home_score] + [away_score] <= 3 then "Medium Scoring" else "High Scoring", type text),
				                #"Added attendance_band" = Table.AddColumn(#"Added match_goal_band", "attendance_band", each if [attendance] < 20000 then "Low" else if [attendance] < 40000 then "Medium" else "High", type text)
				            in
				                #"Added attendance_band"

	annotation PBI_ResultType = Table

