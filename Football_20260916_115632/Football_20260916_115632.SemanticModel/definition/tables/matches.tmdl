table matches
	lineageTag: 0a0a4a5c-6ed3-483d-824a-be2ffe93a04f

	measure 'Total Goals' = SUM('matches'[total_goals])
		lineageTag: 56cbca3f-9463-416a-81e8-981d324cd292

	measure 'Average Goals / Match' = ROUND(DIVIDE(SUM('matches'[total_goals]), DISTINCTCOUNT('matches'[match_id]), BLANK()), 1)
		lineageTag: 0719bf5e-91d6-4053-b38f-bc72e1422f17

	measure 'Matches Played' = DISTINCTCOUNT('matches'[match_id])
		lineageTag: f799480a-b9d9-4379-a4f3-c46b242e39ad

	measure 'Total Attendance' = SUM('matches'[attendance])
