table team_match
	lineageTag: e24d85ea-7221-4902-b36b-2e1b4bf7be55

	measure 'Team Goal Difference' = IF(HASONEVALUE('teams'[team_name]), SUM('team_match'[goals_for]) - SUM('team_match'[goals_against]), BLANK())
		lineageTag: b39b1cc5-4bc9-4e57-b2fc-98e7068268db

	measure 'Dynamic Team Metric' = VAR SelectedMetric =[PerformanceMetric] RETURN SWITCH(SelectedMetric, "Goals", SUM('team_match'[goals_for]), "Points", SUM('view_team_standings'[points]), SUM('matches'[attendance]))
		lineageTag: 7a341730-b172-4ce9-9251-51c870727813

	measure Sum(goals_for) = SUM('team_match'[goals_for])
		lineageTag: fa44cf9e-f497-4048-b761-d5afd55362fe

	measure Sum(goals_against) = SUM('team_match'[goals_against])
		lineageTag: 361eed8e-e26f-45d8-b91d-9f3b27d721a0

	column match_id
		dataType: int64
		formatString: 0
		lineageTag: 1d05dd16-1d2b-498e-8725-ba01ac3d01ac
		summarizeBy: none
		sourceColumn: match_id

		annotation SummarizationSetBy = Automatic

	column team_id
		dataType: int64
		formatString: 0
		lineageTag: bcc72f2c-ac96-4b3b-8c69-a57b3f20a6ac
		summarizeBy: none
