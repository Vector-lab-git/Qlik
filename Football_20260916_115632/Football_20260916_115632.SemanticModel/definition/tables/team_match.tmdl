	column goals_for
		dataType: int64
		formatString: 0
		lineageTag: 59fe08d8-7112-44eb-aa51-5467c7f693fb
		summarizeBy: none
		sourceColumn: goals_for

		annotation SummarizationSetBy = Automatic

	column goals_against
		dataType: int64
		formatString: 0
		lineageTag: 1d130086-3bde-4421-a5d5-258299039178
		summarizeBy: none
		sourceColumn: goals_against

		annotation SummarizationSetBy = Automatic

