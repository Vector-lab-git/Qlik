	partition player_match_stats = m
		mode: import
		source =
				let
				                Source = PostgreSQL.Database("t2f-postgre-server.postgres.database.azure.com", "test"),
				                Result = Value.NativeQuery(Source, "SELECT ""stats_id"", ""match_id"", ""player_id"", ""team_id"", ""minutes_played"", ""goals"", ""assists"", ""shots"", ""shots_on_target"", ""passes_attempted"", ""passes_completed"", ""tackles"", ""interceptions"", ""clearances"", ""fouls_committed"", ""yellow_cards"", ""red_cards"", ""distance_covered_km"", ""player_rating"" FROM ""public"".""player_match_stats""", null, [EnableFolding=false]),
				                #"Renamed Columns" = Table.RenameColumns(Result, {{"team_id", "stats_team_id"}}, MissingField.Ignore),
				                #"Added pass_completion_pct" = Table.AddColumn(#"Renamed Columns", "pass_completion_pct", each if [passes_attempted] > 0 then Number.Round(([passes_completed] / [passes_attempted]) * 100, 1) else 0, type number),
				                #"Added shot_accuracy_pct" = Table.AddColumn(#"Added pass_completion_pct", "shot_accuracy_pct", each if [shots] > 0 then Number.Round(([shots_on_target] / [shots]) * 100, 1) else 0, type number),
				                #"Added goals_per_90" = Table.AddColumn(#"Added shot_accuracy_pct", "goals_per_90", each if [minutes_played] > 0 then Number.Round( ([goals] / [minutes_played]) * 90, 2 ) else 0, type number),
				                #"Added assists_per_90" = Table.AddColumn(#"Added goals_per_90", "assists_per_90", each if [minutes_played] > 0 then Number.Round( ([assists] / [minutes_played]) * 90, 2 ) else 0, type number),
				                #"Added pass_efficiency_band" = Table.AddColumn(#"Added assists_per_90", "pass_efficiency_band", each if [passes_attempted] = 0 then "No Attempts" else if ([passes_completed] / [passes_attempted]) * 100 >= 90 then "Excellent" else if ([passes_completed] / [passes_attempted]) * 100 >= 80 then "Good" else if ([passes_completed] / [passes_attempted]) * 100 >= 70 then "Average" else "Low", type text),
				                #"Added shot_accuracy_band" = Table.AddColumn(#"Added pass_efficiency_band", "shot_accuracy_band", each if [shots] = 0 then "No Shots" else if ([shots_on_target] / [shots]) * 100 >= 60 then "Excellent" else if ([shots_on_target] / [shots]) * 100 >= 40 then "Good" else if ([shots_on_target] / [shots]) * 100 >= 20 then "Average" else "Low", type text)
				            in
				                #"Added shot_accuracy_band"

	annotation PBI_ResultType = Table

