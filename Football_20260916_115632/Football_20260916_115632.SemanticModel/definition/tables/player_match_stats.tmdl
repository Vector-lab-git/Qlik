table player_match_stats
	lineageTag: 7ff52369-eaef-4ac3-8c48-5088d720c03c

	measure 'Total Assists' = SUM('player_match_stats'[assists])
		lineageTag: 9c0eae21-7e23-48ae-b7cb-72ecca289887

	measure 'Shots on Target' = SUM('player_match_stats'[shots_on_target])
		lineageTag: 695133ea-dcf3-43d7-925a-9f9c25ec1313

	measure 'Total Minutes Played' = SUM('player_match_stats'[minutes_played])
		lineageTag: 71456056-d6e5-4d23-8bd2-d59e803408bb

	measure 'Average Player Rating' = MROUND(AVERAGE('player_match_stats'[player_rating]), 2)
		lineageTag: 350b0918-8e25-4812-8861-b1ad0ed092e8

	measure 'Shot Accuracy %' = DIVIDE(SUM('player_match_stats'[shots_on_target]), SUM('player_match_stats'[shots]), BLANK())
		formatString: 0.0%
		lineageTag: 6c12d3e4-8b0a-4a83-a297-f96a6920d938

	measure 'Total Player Goals' = SUM('player_match_stats'[goals])
		lineageTag: f0990bb4-9a9f-40c6-abff-18ae008b0465

	measure 'Shot Accuracy by Player' = ROUND(DIVIDE(SUM('player_match_stats'[shots_on_target]), SUM('player_match_stats'[shots]), BLANK()) * 100, 0)
		lineageTag: 1e929afb-3d1c-491c-bae1-6e90ef775899

	measure 'Total Shots' = SUM('player_match_stats'[shots])
		lineageTag: 147612cd-5cda-4283-91ae-a87d5ba5321b

