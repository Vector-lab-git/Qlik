				                #"Navigation 1" = Source{[Schema = "public", Item = "matches"]}[Data],
				                #"Grouped Calendar" = Table.Group(#"Navigation 1", {"match_date"}, {{"match_year", each List.First(List.Transform([match_date], Date.Year)), type number}, {"match_month", each List.First(List.Transform([match_date], Date.Month)), type number}, {"match_month_year", each List.First(List.Transform([match_date], (d) => Date.ToText(d, "MMM yyyy"))), type text}, {"match_week_number", each List.First(List.Transform([match_date], Date.WeekOfYear)), type number}, {"match_weekday", each List.First(List.Transform([match_date], Date.DayOfWeek)), type number}, {"match_quarter", each List.First(List.Transform([match_date], (d) => Date.ToText(d, "Q" & Number.ToText(Date.QuarterOfYear(d)) & " " & Date.Year(d)))), type text}})
				            in
