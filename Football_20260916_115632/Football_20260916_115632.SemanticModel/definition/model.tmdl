model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["team_match","matches","player_match_stats","match_calendar","teams","view_team_standings","players"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode","WebModelingEdit"]

ref table team_match
ref table matches
ref table player_match_stats
ref table match_calendar
ref table teams
ref table view_team_standings
ref table players
ref table PerformanceMetric
ref table Parameters

ref cultureInfo en-US

